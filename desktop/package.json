{
  "name": "green-vision-desktop",
  "productName": "Green Vision",
  "version": "1.3.0",
  "description": "Green Vision \u2014 urban tree-planting prioritisation for Indian cities. Windows desktop edition.",
  "author": "Green Vision",
  "license": "SEE LICENSE IN ../LICENSE",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:editions": "node build-editions.js both",
    "dist": "node pack.js && electron-builder --win nsis --prepackaged release/GreenVision-win32-x64",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.greenvision.studio",
    "productName": "Green Vision",
    "copyright": "Green Vision",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "auth.js",
      "accounts.js",
      "windows.js",
      "engine.js",
      "build/**/*",
      "config.json"
    ],
    "extraResources": [
      {
        "from": "../dist_app",
        "to": "studio",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GreenVision-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Green Vision",
      "uninstallDisplayName": "Green Vision",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "protocols": [
      {
        "name": "Green Vision",
        "schemes": [
          "greenvision"
        ]
      }
    ],
    "executableName": "GreenVision",
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "GreenVision-${version}-mac-${arch}-beta.${ext}",
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "engine",
          "to": "engine",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  }
}
