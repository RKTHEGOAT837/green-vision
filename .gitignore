.venv/
__pycache__/
*.pyc
# Trained memory, metrics and engine outputs ARE committed: they are the
# evidence behind the numbers in the README, and a reader should be able to
# inspect a result without first running a 7-minute pipeline. They regenerate
# deterministically (seed 42) if you do run it.
# The OpenVINO weights are not — they are fetched by scripts/fetch_openvino_model.py.
models/openvino/
# Downloaded source exports may be large or contain municipal-restricted data.
data/raw/
data/*.tif
# Windows shortcut junk
*.lnk
# local agent/dev config — may contain secrets and machine-specific paths
.claude/

# Internal submission-prep documents — strategy notes, not project code.
submission/
# Superseded build artefacts and stale duplicates.
*.zip
temp_script.js

# Local OSM index: rebuild with scripts/osm_index.py, do not commit (99 MB + 220 MB)
data/osm/*.pbf
data/osm/*.jsonl.gz

# Built OSM indexes are large and regenerable from the PBFs.
data/osm/*.jsonl.gz
data/osm/*.pbf
logs/

# Android toolchain and build output — large, machine-specific, regenerable
android-sdk/
android/local.properties
android/.gradle/
android/app/build/
android/app/src/main/assets/www/
dist_app/

# Local Netlify folder
.netlify

# The Windows desktop app. The SOURCE here is committed - main.js, preload.js,
# the build scripts - and everything the build PRODUCES is not:
#   engine/        a complete CPython, the OpenVINO runtime, the map index and
#                  the 1.2 GB INT4 language model. Rebuild it with
#                  scripts/build_portable_engine.py --with-openvino
#   release/       the packaged app and the two installers, 1.2 GB each
#   node_modules/  electron and electron-builder
desktop/engine/
desktop/release/
desktop/node_modules/
desktop/*-shots/
desktop/site-report/

# Editor and tooling leavings, and the backups the i18n filler writes.
*.bak
.ovcache/
data/geti_tiles/
desktop/.engine-cache/
server/node_modules/
